datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("RECRUITER") // ADMIN, RECRUITER, REVIEWER, CANDIDATE
  avatarUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdJobs  Job[]
  reviews      Review[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Job {
  id              String        @id @default(cuid())
  title           String
  department      String
  location        String
  type            String        @default("Full-time") // Full-time, Remote, Contract, Hybrid
  experienceLevel String        @default("Mid-Level") // Junior, Mid-Level, Senior, Lead
  minSalary       Int?
  maxSalary       Int?
  currency        String        @default("NZD")
  description     String        @db.Text
  requiredSkills  String        @db.Text // Comma separated list of required skills
  status          String        @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, CLOSED
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  applications    Application[]

  @@index([status])
  @@index([department])
  @@map("jobs")
}

model Application {
  id                     String      @id @default(cuid())
  jobId                  String
  job                    Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateName          String
  candidateEmail         String
  candidatePhone         String?
  portfolioUrl           String?
  githubUrl              String?
  linkedinUrl            String?
  experienceYears        Float       @default(0)
  resumeText             String      @db.Text
  
  // Workflow Status State Machine:
  // APPLIED -> SCREENING -> AI_ANALYZED -> INTERVIEW_SCHEDULED -> OFFER_EXTENDED -> HIRED / REJECTED
  status                 String      @default("APPLIED")
  rejectionReason        String?     @db.Text
  stageChangedAt         DateTime    @default(now())

  // AI / ML Evaluation Results
  aiScore                Float?      // 0 - 100
  aiMatchLevel           String?     // HIGH_MATCH (>=80), MODERATE_MATCH (50-79), LOW_MATCH (<50)
  aiSummary              String?     @db.Text // Executive overview of qualifications
  aiMatchedSkills        String?     @db.Text // JSON array of matched skills
  aiMissingSkills        String?     @db.Text // JSON array of missing required skills
  aiRecommendedQuestions String?     @db.Text // JSON array of customized interview questions
  aiEvaluatedAt          DateTime?

  // Business Logic Weighted Composite Score
  // Composite = (aiScore * 0.30) + (reviewsTechnicalAvg * 0.45) + (reviewsSoftSkillsAvg * 0.25)
  compositeScore         Float?

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  reviews                Review[]
  auditLogs              AuditLog[]

  @@index([jobId])
  @@index([status])
  @@index([candidateEmail])
  @@map("applications")
}

model Review {
  id                 String      @id @default(cuid())
  applicationId      String
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId         String
  reviewer           User        @relation(fields: [reviewerId], references: [id])
  stage              String      @default("TECHNICAL") // SCREENING, TECHNICAL, CULTURE_FIT
  technicalScore     Int         // 1 to 10
  communicationScore Int         // 1 to 10
  cultureScore       Int         // 1 to 10
  overallScore       Float       // Weighted avg of criteria
  recommendation     String      // STRONG_YES, YES, HOLD, NO
  comments           String      @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([applicationId])
  @@index([reviewerId])
  @@map("reviews")
}

model AuditLog {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?        @relation(fields: [actorId], references: [id])
  action        String       // STATUS_CHANGED, AI_ANALYZED, REVIEW_ADDED, APPLICATION_SUBMITTED
  fromStatus    String?
  toStatus      String?
  details       String?      @db.Text
  createdAt     DateTime     @default(now())

  @@index([applicationId])
  @@index([createdAt])
  @@map("audit_logs")
}
